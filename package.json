{
  "name": "portrail",
  "version": "0.1.2",
  "private": false,
  "description": "Remote-control Codex and Claude Code over a local HTTP gateway.",
  "keywords": [
    "agent",
    "codex",
    "claude-code",
    "gateway",
    "api",
    "automation"
  ],
  "license": "MIT",
  "author": "Philipp Werdecker",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "portrail": "bin/portrail.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    },
    "./package.json": "./package.json",
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "openapi.json",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "dev": "node --import tsx src/cli/main.ts",
    "doctor": "node --import tsx src/cli/main.ts doctor",
    "e2e": "node --import tsx scripts/e2e.ts",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.ts\" \"*.{json,md}\"",
    "test:install": "bash scripts/install-test.sh",
    "e2e:sandbox": "node --import tsx scripts/e2e-sandbox.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "release": "npm run typecheck && npm test && npm run build && npm sbom --sbom-format cyclonedx > sbom.json"
  },
  "dependencies": {
    "fastify": "5.12.4"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.268"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PortRail/portrail.git"
  },
  "homepage": "https://github.com/PortRail/portrail#readme",
  "bugs": {
    "url": "https://github.com/PortRail/portrail/issues"
  }
}
